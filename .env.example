# ArthaLens — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arthalens
POSTGRES_USER=arthalens
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Backend API (Spring Boot)
API_PORT=8080
SPRING_PROFILES_ACTIVE=local
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8001/ai/v1
NEXT_PUBLIC_APP_ENV=development

# AI / RAG Service
AI_SERVICE_PORT=8001

# LLM provider — set ONE group:
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_sk_...
# ANTHROPIC_API_KEY=CHANGE_ME_...
# GOOGLE_API_KEY=CHANGE_ME_...
# OLLAMA_BASE_URL=http://localhost:11434

LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Vector store
VECTOR_STORE=pgvector
# QDRANT_URL=http://localhost:6333

# ML Service
ML_SERVICE_PORT=8002
ML_RANDOM_SEED=42

# Ingestion
INGESTION_RAW_ARCHIVE_PATH=./raw_archive
INGESTION_QUARANTINE_PATH=./quarantine
INGESTION_LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=2

# Security
JWT_SECRET=CHANGE_ME_minimum_32_chars
JWT_EXPIRY_HOURS=24

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER=none
